
// 评论区颜色重置
.gt-container
  .gt-ico-tip
    &::after
      content: '。( Win + . ) 或 ( ⌃ + ⌘ + ␣ ) 打开表情'
      color: #999
      font-size: .8rem
  .gt-meta
    border-color var(--borderColor)!important
  .gt-comments-null
    color var(--textColor)
    opacity .5
  .gt-header-textarea
    color var(--textColor)
    background rgba(180,180,180,0.1)!important
  .gt-btn
    border-color $accentColor!important
    background-color $accentColor!important
  .gt-btn-preview
    background-color rgba(255,255,255,0)!important
    color $accentColor!important
  a
    color $accentColor!important
  .gt-svg svg
    fill $accentColor!important
  .gt-comment-content,.gt-comment-admin .gt-comment-content
    background-color rgba(150,150,150,0.1)!important
    &:hover
      box-shadow 0 0 25px rgba(150,150,150,.5)!important
    .gt-comment-body
      color var(--textColor)!important


// qq徽章
.qq
  position: relative;
.qq::after
  content: "可撩";
  background: $accentColor;
  color:#fff;
  padding: 0 5px;
  border-radius: 10px;
  font-size:12px;
  position: absolute;
  top: -4px;
  right: -35px;
  transform:scale(0.85);

// demo模块图标颜色
body .vuepress-plugin-demo-block__wrapper
  &,.vuepress-plugin-demo-block__display
    border-color rgba(160,160,160,.3)
  .vuepress-plugin-demo-block__footer:hover
    .vuepress-plugin-demo-block__expand::before
      border-top-color: $accentColor !important;
      border-bottom-color: $accentColor !important;
    svg
      fill: $accentColor !important;

// 全文搜索框
.suggestions
  overflow: auto
  max-height: calc(100vh - 6rem)
  @media (max-width: 719px) {
    width: 90vw;
    min-width: 90vw!important;
    margin-right: -20px;
  }
  .highlight
    color: $accentColor
    font-weight: bold

// -----------------------------------------------------------------------------
// 站点视觉系统
// -----------------------------------------------------------------------------

body.theme-mode-light
  --bodyBg: #f3f7f6
  --mainBg: #ffffff
  --sidebarBg: rgba(250, 253, 252, .94)
  --blurBg: rgba(250, 253, 252, .86)
  --customBlockBg: #edf5f3
  --textColor: #153e43
  --textLightenColor: #647d80
  --borderColor: rgba(21, 62, 67, .12)
  --surfaceSoft: #edf5f3
  --surfaceRaised: rgba(255, 255, 255, .92)
  --heroCard: rgba(255, 255, 255, .08)
  --heroCardHover: rgba(255, 255, 255, .14)
  --shadowSoft: 0 12px 34px rgba(19, 58, 61, .08)
  --shadowHover: 0 18px 44px rgba(15, 74, 78, .15)

body.theme-mode-dark
  --bodyBg: #101a1c
  --mainBg: #172326
  --sidebarBg: rgba(19, 31, 34, .94)
  --blurBg: rgba(16, 27, 29, .86)
  --customBlockBg: #1d3033
  --textColor: #d6e4e2
  --textLightenColor: #91aaa7
  --borderColor: rgba(204, 230, 226, .12)
  --surfaceSoft: #1c2d30
  --surfaceRaised: rgba(24, 39, 42, .94)
  --heroCard: rgba(255, 255, 255, .07)
  --heroCardHover: rgba(255, 255, 255, .12)
  --shadowSoft: 0 14px 36px rgba(0, 0, 0, .2)
  --shadowHover: 0 20px 48px rgba(0, 0, 0, .32)

body.theme-mode-read
  --bodyBg: #eee8da
  --mainBg: #faf5e9
  --sidebarBg: rgba(248, 242, 228, .95)
  --blurBg: rgba(248, 242, 228, .9)
  --customBlockBg: #eee5d3
  --textColor: #4e4334
  --textLightenColor: #7b6d5a
  --borderColor: rgba(78, 67, 52, .15)
  --surfaceSoft: #f0e8d8
  --surfaceRaised: rgba(250, 245, 233, .94)
  --heroCard: rgba(255, 255, 255, .08)
  --heroCardHover: rgba(255, 255, 255, .14)
  --shadowSoft: 0 12px 34px rgba(79, 63, 39, .09)
  --shadowHover: 0 18px 44px rgba(79, 63, 39, .15)

html
  scroll-behavior smooth

body
  font-family Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif
  letter-spacing .01em
  transition background-color .25s ease, color .25s ease

::selection
  color #fff
  background rgba(15, 124, 130, .78)

a, button, input
  &:focus-visible
    outline 3px solid rgba(239, 139, 95, .45) !important
    outline-offset 3px

.card-box
  border 1px solid var(--borderColor)
  border-radius 16px
  box-shadow var(--shadowSoft)
  transition transform .28s ease, box-shadow .28s ease, border-color .28s ease, background-color .28s ease
  &:hover
    box-shadow var(--shadowHover)

// 顶部导航：强化当前位置、搜索聚焦和下拉反馈。
.navbar
  border-bottom 1px solid var(--borderColor)
  box-shadow 0 8px 28px rgba(16, 56, 59, .06)
  transition transform .3s ease, background-color .25s ease, box-shadow .25s ease
  .home-link
    .logo
      border-radius 12px
      box-shadow 0 5px 15px rgba(15, 74, 78, .12)
      transition transform .28s ease, box-shadow .28s ease
    .site-name
      letter-spacing -.02em
      &::after
        content ''
        display inline-block
        width .38rem
        height .38rem
        margin-left .35rem
        border-radius 50%
        background $activeColor
        vertical-align middle
        box-shadow 0 0 0 5px rgba(239, 139, 95, .12)
    &:hover
      .logo
        transform rotate(-3deg) scale(1.05)
        box-shadow 0 8px 22px rgba(15, 74, 78, .2)
  .links
    align-items center
  .search-box
    input
      width 10rem
      border-radius 999px
      background-color var(--surfaceRaised)
      box-shadow inset 0 0 0 1px rgba(255, 255, 255, .04)
      transition width .3s ease, border-color .25s ease, box-shadow .25s ease, background-color .25s ease
      &:focus
        width 15rem
        border-color rgba(15, 124, 130, .45)
        box-shadow 0 0 0 4px rgba(15, 124, 130, .1)

.nav-links
  .nav-item > a,
  .nav-item .dropdown-title .link-title,
  .repo-link
    position relative
    border-bottom 0 !important
    margin-bottom 0 !important
    transition color .22s ease
    &::after
      content ''
      position absolute
      left 50%
      right 50%
      bottom -.65rem
      height 2px
      border-radius 999px
      background linear-gradient(90deg, $accentColor, $activeColor)
      transition left .24s ease, right .24s ease
    &:hover::after,
    &.router-link-active::after
      left 0
      right 0
  .dropdown-title
    transition color .22s ease
    &:hover
      color $accentColor

.dropdown-wrapper .nav-dropdown
  border-radius 14px
  border-color var(--borderColor)
  box-shadow 0 18px 45px rgba(17, 51, 54, .16)
  overflow hidden
  .dropdown-item a
    padding-top .25rem
    padding-bottom .25rem
    transition color .2s ease, background-color .2s ease, padding-left .2s ease
    &:hover
      padding-left 1.5rem
      background var(--surfaceSoft)

// 首页首屏：从模板式网格升级为更有呼吸感的“知识花园”。
.home-wrapper
  .banner
    min-height 620px
    isolation isolate
    background radial-gradient(circle at 18% 15%, rgba(37, 184, 177, .2), transparent 28%), radial-gradient(circle at 86% 20%, rgba(239, 139, 95, .16), transparent 24%), linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px), linear-gradient(135deg, #122d32 0%, #0d2025 58%, #162b30 100%) !important
    background-size auto, auto, 42px 42px, 42px 42px, auto !important
    &::before
      content ''
      position absolute
      z-index -1
      top -12rem
      left 50%
      width 44rem
      height 44rem
      border 1px solid rgba(255, 255, 255, .06)
      border-radius 50%
      transform translateX(-50%)
      box-shadow 0 0 0 8rem rgba(255, 255, 255, .018), 0 0 0 16rem rgba(255, 255, 255, .012)
    &::after
      content ''
      position absolute
      z-index -1
      left 0
      right 0
      bottom 0
      height 10rem
      background linear-gradient(to bottom, transparent, rgba(5, 18, 21, .28))
    .banner-conent
      padding 4.2rem 1.25rem 3.6rem
      box-sizing border-box
      overflow visible
      .hero
        margin-top 0
        h1
          max-width 100%
          font-size clamp(2.7rem, 5vw, 4rem)
          line-height 1.08
          letter-spacing -.055em
          text-wrap balance
          animation hero-rise .65s cubic-bezier(.2, .7, .2, 1) both
          &::before
            content 'BOBO · KNOWLEDGE GARDEN'
            display block
            margin-bottom 1rem
            color rgba(214, 244, 239, .72)
            font-size .72rem
            line-height 1
            font-weight 600
            letter-spacing .22em
        .description
          max-width 44rem
          margin-top 1.25rem
          font-size 1.05rem
          line-height 1.8
          color rgba(232, 246, 244, .82)
          animation hero-rise .65s .08s cubic-bezier(.2, .7, .2, 1) both
        .action
          margin-top 1.75rem
          animation hero-rise .65s .16s cubic-bezier(.2, .7, .2, 1) both
        .action-button
          padding .78rem 1.45rem
          border 1px solid rgba(255, 255, 255, .2)
          border-radius 999px
          background linear-gradient(135deg, $accentColor, #13949a)
          box-shadow 0 12px 30px rgba(5, 24, 27, .28)
          transition transform .25s ease, box-shadow .25s ease, background .25s ease
          &:hover
            color #fff
            background linear-gradient(135deg, #159096, $activeColor)
            box-shadow 0 16px 36px rgba(5, 24, 27, .38)
            transform translateY(-3px)
      .features
        display grid !important
        grid-template-columns repeat(4, minmax(0, 1fr))
        gap 1rem
        margin-top 3rem
        padding 0
        align-items stretch
        .feature
          max-width none !important
          padding 1.15rem 1rem 1.05rem
          border 1px solid rgba(255, 255, 255, .1)
          border-radius 18px
          background var(--heroCard)
          backdrop-filter blur(10px)
          box-shadow 0 18px 40px rgba(4, 18, 21, .14)
          opacity 0
          transform translateY(16px)
          animation feature-rise .55s cubic-bezier(.2, .7, .2, 1) forwards
          transition transform .28s ease, border-color .28s ease, background-color .28s ease, box-shadow .28s ease
          &:nth-child(2)
            animation-delay .08s
          &:nth-child(3)
            animation-delay .16s
          &:nth-child(4)
            animation-delay .24s
          a
            display block
            height 100%
          .feature-img
            width 8.8rem
            height 8.8rem
            object-fit cover
            border-radius 16px
            animation none
            box-shadow 0 15px 32px rgba(3, 18, 22, .28)
            transition transform .35s cubic-bezier(.2, .7, .2, 1), box-shadow .35s ease
          h2
            margin .95rem 0 .25rem
            color #f4fffd
            font-weight 650
            letter-spacing -.02em
            transition color .25s ease
          p
            min-height 2.8em
            margin .35rem 0 0
            color rgba(226, 242, 239, .74)
            line-height 1.6
            opacity 1
            transition color .25s ease
          &:hover
            transform translateY(-8px)
            border-color rgba(95, 221, 210, .36)
            background var(--heroCardHover)
            box-shadow 0 24px 52px rgba(3, 18, 22, .3)
            .feature-img
              transform translateY(-3px) scale(1.04)
              box-shadow 0 20px 38px rgba(3, 18, 22, .4)
            h2
              color #7ce0d7
            p
              color rgba(242, 251, 249, .9)
  .main-wrapper
    margin-top 0
    padding-top 2.5rem
    animation content-reveal .55s .12s ease both

// 首页文章列表：整张卡片都有明确的“可继续阅读”反馈。
.post-list
  margin-bottom 2.2rem
  .post
    overflow hidden
    padding 1.25rem 1.5rem
    margin-bottom .85rem
    border-color var(--borderColor)
    transform translateZ(0)
    transition transform .26s ease, box-shadow .26s ease, border-color .26s ease, background-color .26s ease
    &::after
      content ''
      position absolute
      top 1rem
      bottom 1rem
      left 0
      width 3px
      border-radius 0 999px 999px 0
      background linear-gradient($accentColor, $activeColor)
      opacity 0
      transform scaleY(.55)
      transition opacity .25s ease, transform .25s ease
    &:hover
      z-index 1
      transform translateY(-4px)
      border-color rgba(15, 124, 130, .28)
      &::after
        opacity 1
        transform scaleY(1)
    .title-wrapper
      h2
        margin .25rem 0 .55rem
        font-size 1.36rem
        line-height 1.45
        a
          position relative
          padding-right 2rem
          &::after
            content '↗'
            position absolute
            top 50%
            right .15rem
            color $accentColor
            opacity 0
            transform translate(-8px, -50%)
            transition opacity .22s ease, transform .22s ease
          &:hover
            text-decoration none
            &::after
              opacity 1
              transform translate(0, -50%)
      .article-info
        display flex
        flex-wrap wrap
        gap .35rem 1rem
        color var(--textLightenColor)
        > a, > span
          margin-right 0
          opacity .88
    .excerpt-wrapper
      margin-top .85rem
      padding-top .85rem
      border-top 1px dashed var(--borderColor)
      .excerpt
        color var(--textLightenColor)
        line-height 1.75
      .readmore
        float none
        display inline-flex
        align-items center
        margin .5rem 0 0
        font-size .86rem
        transition transform .2s ease
        &:hover
          text-decoration none
          transform translateX(3px)

// 分类、标签与分页保留信息密度，但提供更清晰的触达反馈。
.categories-wrapper,
.tags-wrapper
  .title
    font-weight 650
    letter-spacing -.02em

.categories-wrapper .categories a
  border-radius 8px
  margin .15rem .55rem
  padding-left .75rem
  padding-right .75rem
  transition transform .2s ease, color .2s ease, background-color .2s ease, border-color .2s ease
  &:not(.active):hover
    background var(--surfaceSoft) !important
    transform translateX(3px)
  &.active
    background linear-gradient(135deg, $accentColor, #169098)
    border-radius 8px

.tags-wrapper .tags a
  height auto
  min-height 1rem
  padding .3rem .55rem
  border 1px solid var(--borderColor)
  border-radius 999px
  background var(--surfaceSoft) !important
  color var(--textColor) !important
  line-height 1.25
  opacity .9
  transition transform .2s ease, color .2s ease, border-color .2s ease, background-color .2s ease
  &:hover
    color $accentColor !important
    border-color rgba(15, 124, 130, .35)
    transform translateY(-2px)
  &.active
    color #fff !important
    background $accentColor !important
    transform none

.pagination
  .card-box
    border-radius 12px
  .pagination-list span
    transition transform .2s ease, color .2s ease, background-color .2s ease
    &:hover
      transform translateY(-2px)
    &.active
      color #fff
      background linear-gradient(135deg, $accentColor, #169098)

// 文章页：让长文阅读更松弛，标题与目录状态更有层次。
.page > .theme-vdoing-wrapper
  border 1px solid var(--borderColor)
  border-radius 18px
  box-shadow var(--shadowSoft)
  animation content-reveal .48s ease both

.theme-vdoing-wrapper
  .content-wrapper > h1
    margin-top .45rem
    font-size clamp(2rem, 4vw, 2.55rem)
    line-height 1.28
    letter-spacing -.045em
  .theme-vdoing-content
    color var(--textColor)
    p, ul, ol
      line-height 1.9
    h2
      position relative
      margin-top 1.25rem
      padding-left 1rem
      padding-bottom .45rem
      border-bottom 0
      letter-spacing -.025em
      &::before
        content ''
        position absolute
        top calc(50% + 1.9rem)
        bottom .55rem
        left 0
        width 4px
        min-height 1.35rem
        border-radius 999px
        background linear-gradient($accentColor, $activeColor)
    h3
      letter-spacing -.018em
    blockquote
      margin 1.5rem 0
      padding .9rem 1.1rem
      border-left .25rem solid $accentColor
      border-radius 0 12px 12px 0
      background var(--surfaceSoft)
      opacity 1
    table
      border-radius 10px
      box-shadow 0 0 0 1px var(--borderColor)
      overflow hidden
    div[class*="language-"]
      border 1px solid rgba(125, 160, 158, .15)
      border-radius 12px
      box-shadow 0 12px 30px rgba(0, 0, 0, .08)
    img
      border-radius 10px

.articleInfo-wrap
  color var(--textLightenColor) !important
  .articleInfo
    padding-bottom .35rem
    border-bottom 1px dashed var(--borderColor)
    .breadcrumbs a,
    .info a
      color var(--textLightenColor) !important

.right-menu-wrapper
  .right-menu-margin
    border 1px solid var(--borderColor)
    border-radius 14px
    box-shadow var(--shadowSoft)
    background var(--mainBg)
  .right-menu-title
    font-weight 650
  .right-menu-content .right-menu-item
    transition background-color .2s ease, padding-left .2s ease
    &:hover
      background var(--surfaceSoft)
    &.active
      background var(--surfaceSoft)

.sidebar
  box-shadow 12px 0 34px rgba(12, 42, 45, .06)
  a.sidebar-link,
  .sidebar-heading
    transition color .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease
    &:hover
      background var(--surfaceSoft)
  a.sidebar-link:hover
    transform translateX(2px)

.page-nav .inner
  display flex
  gap 1rem
  justify-content space-between
  padding-top 1.25rem
  .prev, .next
    float none
    a
      display inline-block
      padding .55rem .75rem
      border-radius 10px
      background var(--surfaceSoft)
      transition transform .2s ease, background-color .2s ease
      &:hover
        text-decoration none
        transform translateY(-2px)

.buttons
  .button
    border 1px solid var(--borderColor)
    box-shadow 0 8px 24px rgba(18, 55, 58, .16)
    transition transform .24s ease, background-color .24s ease, box-shadow .24s ease
    @media (any-hover hover)
      &:hover
        transform translateY(-3px) scale(1.04)
        box-shadow 0 12px 28px rgba(15, 124, 130, .28)
  .select-box
    border-radius 12px !important
    box-shadow var(--shadowHover) !important

.footer
  color var(--textLightenColor)
  .icons .iconfont
    display inline-block
    transition transform .2s ease, color .2s ease
    &:hover
      transform translateY(-3px)

@keyframes hero-rise
  from
    opacity 0
    transform translateY(18px)
  to
    opacity 1
    transform translateY(0)

@keyframes feature-rise
  to
    opacity 1
    transform translateY(0)

@keyframes content-reveal
  from
    opacity 0
    transform translateY(12px)
  to
    opacity 1
    transform translateY(0)

// 移动端：避免标题与摘要裁切，并把滑动栏目做成可感知的卡片。
@media (max-width: $MQMobile)
  .navbar
    padding-left 4.25rem
    .home-link .logo
      border-radius 10px
    .links
      right .85rem
  .sidebar-button
    border-radius 0 12px 12px 0
    transition left .2s ease, background-color .2s ease
  .home-wrapper
    .banner
      min-height 610px
      .banner-conent
        padding 3.5rem 1.25rem 1rem
        .hero
          h1
            width 100%
            font-size clamp(2.15rem, 10vw, 3rem)
            letter-spacing -.05em
            white-space normal
          .description
            max-width 21rem
            padding 0 .5rem
            font-size 1rem
            line-height 1.75
            white-space normal
          .action-button
            font-size .95rem
            padding .7rem 1.2rem
      .slide-banner
        margin-top 1.25rem
        .slide-banner-wrapper
          height 320px
          .slide-item
            height 300px
            a
              display block
              width calc(100% - 2.5rem)
              height 275px
              margin 0 1.25rem
              padding 1.1rem
              box-sizing border-box
              border 1px solid rgba(255, 255, 255, .11)
              border-radius 18px
              background var(--heroCard)
              box-shadow 0 18px 40px rgba(3, 18, 22, .2)
            .feature-img
              width 8.5rem
              height 8.5rem
              object-fit cover
              border-radius 15px
              box-shadow 0 14px 30px rgba(3, 18, 22, .3)
            h2
              margin .7rem 0 .3rem
              color #f4fffd
            p
              margin .2rem auto 0
              max-width 17rem
              color rgba(232, 246, 244, .78)
              line-height 1.55
              opacity 1
        .docs-wrapper
          bottom 10px
          .doc
            width 7px
            height 7px
            background rgba(255, 255, 255, .55)
            transition width .25s ease, opacity .25s ease
            &.active
              width 20px
              border-radius 999px
              background #72d9d0
              opacity 1
    .main-wrapper
      margin 0
      padding 1.25rem .75rem 0
      .main-left .post-list .post
        border-radius 14px
      .main-right .card-box
        border-radius 14px
  .post-list
    .post
      padding 1.15rem 1.1rem
      .title-wrapper
        h2
          font-size 1.22rem
          a
            padding-right 0
            &::after
              display none
        .article-info
          display flex
          max-width 100%
          overflow visible
          > a, > span
            max-width 100%
            white-space normal
            word-break break-word
  .page > .theme-vdoing-wrapper
    border-left 0
    border-right 0
    border-radius 0
  .page-nav .inner
    flex-direction column
    align-items stretch
    .next
      text-align right

@media (max-width: $MQMobileNarrow)
  .home-wrapper .banner .banner-conent .hero
    h1::before
      font-size .64rem
      letter-spacing .14em
    .description
      font-size .96rem
  .home-wrapper .main-wrapper
    padding-left .55rem
    padding-right .55rem
  .post-list .post .title-wrapper .article-info
    gap .25rem .7rem

@media (prefers-reduced-motion: reduce)
  html
    scroll-behavior auto
  *, *::before, *::after
    animation-duration .01ms !important
    animation-iteration-count 1 !important
    transition-duration .01ms !important
    scroll-behavior auto !important
