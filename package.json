{
  "name": "theme-vdoing-blog",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--openssl-legacy-provider node --max_old_space_size=4096 ./node_modules/vuepress/cli.js dev docs",
    "build": "NODE_OPTIONS=--openssl-legacy-provider node --max_old_space_size=4096 ./node_modules/vuepress/cli.js build docs",
    "check": "node scripts/check-site.js",
    "check:dist": "node scripts/check-dist.js",
    "verify": "npm run check && npm run build && npm run check:dist",
    "deploy": "bash deploy.sh",
    "deploy:dry-run": "DEPLOY_DRY_RUN=1 bash deploy.sh",
    "editFm": "NODE_OPTIONS=--openssl-legacy-provider node utils/editFrontmatter.js",
    "baiduPush": "node utils/baiduPush.js && bash baiduPush.sh",
    "publish": "cd ./vdoing && npm publish && cd .. && yarn updateTheme",
    "updateTheme": "yarn remove vuepress-theme-vdoing && rm -rf node_modules && yarn && yarn add vuepress-theme-vdoing -D"
  },
  "license": "MIT",
  "devDependencies": {
    "@maginapp/vuepress-plugin-katex": "^1.0.11",
    "dayjs": "^1.9.7",
    "inquirer": "^7.1.0",
    "json2yaml": "^1.1.0",
    "vuepress": "^1.9.5",
    "vuepress-plugin-baidu-autopush": "^1.0.1",
    "vuepress-plugin-baidu-tongji": "^1.0.1",
    "vuepress-plugin-comment": "^0.7.3",
    "vuepress-plugin-demo-block": "^0.7.2",
    "vuepress-plugin-fulltext-search": "^2.2.1",
    "vuepress-plugin-mathjax": "^1.2.8",
    "vuepress-plugin-one-click-copy": "^1.0.2",
    "vuepress-plugin-sitemap": "^2.3.1",
    "vuepress-plugin-thirdparty-search": "^1.0.2",
    "vuepress-plugin-zooming": "^1.1.7",
    "vuepress-theme-vdoing": "^1.12.8",
    "yamljs": "^0.3.0"
  },
  "dependencies": {
    "@renovamen/vuepress-plugin-katex": "^0.2.0",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-latex2img": "^0.0.6",
    "mathjax-full": "^3.2.2",
    "vuepress-plugin-latex": "^0.1.3",
    "vuepress-plugin-mathjax": "^1.2.8"
  }
}
